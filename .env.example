# Copy to .env and fill in real secrets. Never commit .env.
PORT=3000
JWT_SECRET=change-me-to-a-long-random-secret

# Local Postgres (create once, see docs/mongo-to-postgres-mapping.md)
DATABASE_URL="postgresql://konkur_app:change-me@127.0.0.1:5432/konkur_ai"
# Set to "true" on hosted deploys (e.g. Cloudflare) that require TLS.
DB_SSL=false

GEMINI_API_KEYS=key1,key2
OPENROUTER_API_KEYS=key1,key2
